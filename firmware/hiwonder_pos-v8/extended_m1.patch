+void apply_project_motor_config(void)
+{
+    /* JGB37-520R30-12 on M1 and on the position motor (M4 since 2026-10-04):
+       11 lines * x4 quadrature * 1:30 reduction = 1320 ticks per revolution of the
+       output shaft.
+
+       Gains: do NOT use the JGB520 profile imposed by the JETACKER chassis (3960
+       ticks, KP 63), tuned for a 1:90 reduction. A 1:30 spins ~3x faster
+       for the same PWM, so the open-loop gain is ~3x higher and the
+       loop oscillates. The manufacturer itself lowers KP from 63 to 40 in its JGB37
+       profile (1980 ticks). Validated on the bench on M1 (2026-08-22). */
+    set_motor_param(motors[0], 1320, PROJECT_MOTOR_RPS_LIMIT, 21.0f, 0.9f, 0.8f);
+    set_motor_param(motors[POSITION_MOTOR_INDEX], 1320, PROJECT_MOTOR_RPS_LIMIT, 21.0f, 0.9f, 0.8f);
+}
