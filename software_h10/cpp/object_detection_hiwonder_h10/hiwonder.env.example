# Copiar como hiwonder.env y medir cada valor en el robot real.
# El archivo de ejemplo nunca arma el vehículo por sí solo.
HIWONDER_ARM=0

# Puede dejarse vacío si sólo existe un adaptador QinHeng 1a86 en by-id.
HIWONDER_DEVICE=

# HX-12H: medir sin varillaje antes de armar.
HIWONDER_STEERING_ID=
HIWONDER_STEERING_LEFT=
HIWONDER_STEERING_CENTER=
HIWONDER_STEERING_RIGHT=
HIWONDER_STEERING_DURATION_MS=300

# Conversión física. Todos requieren calibración; no copie factores del LEGO.
HIWONDER_PD_OUTPUT_TO_STEERING=
HIWONDER_TIRE_TURN_TO_STEERING=
HIWONDER_RPS_AT_SPEED_100=
HIWONDER_TRACTION_DIRECTION=
HIWONDER_MAX_RPS=
HIWONDER_WHEEL_DIAMETER_MM=
HIWONDER_DISTANCE_SCALE=1.0

# Ganancias del PD del nuevo chasis. Se dejan vacías intencionalmente.
HIWONDER_FORWARD_KP=
HIWONDER_FORWARD_KD=
HIWONDER_FOLLOW_KP=
HIWONDER_FOLLOW_KD=
HIWONDER_ADVANCE_KP=
HIWONDER_ADVANCE_KD=

# Valores del control posicional M1 ya validados sin carga.
HIWONDER_POSITION_TOLERANCE_TICKS=15
HIWONDER_POSITION_TIMEOUT_MS=20000
HIWONDER_CONTROL_PERIOD_MS=20
