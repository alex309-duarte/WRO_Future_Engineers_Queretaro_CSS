# Ignore the folder named 'logs'
# Git ignore sections
#
# =========================================================

# ignore generated files after compilation
src/cpp/object_detection/build/aarch64/_deps/
src/cpp/object_detection_original_h10/build/h10_original/_deps/ 

#ignore dir files
*.dir

# ignore processed_video 
video~/

/src/cpp/object_detection_original_h10/build/h10_original/nul

#ignore all the .log files
*.log  
other/additionalMedia/Videos/fpv.mp4

# Binary of the offline tests of the Hiwonder layer
/src/ondevice/tests/spike_hiwonder_test
.lidar_*

# =========================================================
# Build output and compiled binaries (rebuild with the
# instructions in README §9; never commit them)
# =========================================================
/build/
src/cpp/**/build/
src/cpp/**/build_*/
src/ondevice/my_lidar_app
src/ondevice/controlc
__pycache__/
*.pyc

# Windows reserved file name created by "> nul" on Linux
nul

# Large archives (GitHub rejects files over 100 MB)
*.zip

# Work folder created when building the board firmware from source
firmware/hiwonder_pos-v8/work/


# Editor settings of each computer
.vscode/

# Videos recorded on the robot with -s (processed_video.avi, lidar_video.avi)
*.avi
